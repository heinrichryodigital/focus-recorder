# Copy to .env.local for local development. Never commit actual credentials.
# Current checkout is mock-only; adding keys does not enable real payments.
PAYMENTS_MODE=mock
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
APP_URL=http://localhost:3000
# Account configuration is used by the separately assembled private backend.
# Firebase web settings are public identifiers, not Admin/service-account credentials.
ACCOUNT_LOGIN_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
